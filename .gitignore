# Your real workspace list. Copy workspaces.example.yml to workspaces.yml and
# edit. Kept out of the tree so a public clone carries no real workspace names
# or ids.
workspaces.yml

# Your own words for check-leaks to refuse: names the manifest does not hold.
# Private by definition.
.leak-words

# Generated by `make install`. node_modules is rebuilt from package-lock.json
# by npm ci, and .node-path holds an absolute path on your machine.
node_modules/
.node-path

# Tokens never belong in the tree. They live in the macOS Keychain, service
# many-notions, one item per slug. If any of these ever shows up in
# `git status`, something copied a token here, and the fix is to find out
# what, not to add an exception.
.env
.env.*
*.token
*.secret
*token*.txt
*secret*.txt
*.pem
*.key
notion*.json

# Claude's own config files hold absolute paths and other servers' settings.
# make desktop backs the desktop one up next to the original, never here, but
# a hand copy for debugging would land here.
claude_desktop_config*.json
.claude.json
*.bak

# Local tool state
.claude/settings.local.json
npm-debug.log*
.DS_Store
__pycache__/
*.pyc
